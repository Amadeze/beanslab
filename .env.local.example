# DATABASE
DATABASE_URL="postgresql://user:PASSWORD@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:PASSWORD@host:5432/database"
# Per-instance pool. Keep this small on Vercel; the DB transaction pooler
# multiplexes connections across serverless instances.
DATABASE_POOL_MAX="5"

# SESSION (minimum 32 characters)
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"
CREDENTIAL_ENCRYPTION_KEY="independent-random-secret-at-least-32-chars"
CRON_SECRET="independent-random-secret-at-least-32-chars"

# APPLICATION
APP_URL="https://app.example.com"
NEXT_PUBLIC_APP_URL="https://app.example.com"
TENANT_ROOT_DOMAIN="roastd.id"
NEXT_PUBLIC_TENANT_ROOT_DOMAIN="roastd.id"

# OBJECT STORAGE (required for uploads)
SUPABASE_URL="https://project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
SUPABASE_STORAGE_BUCKET="roastery-assets"
SUPABASE_PRIVATE_STORAGE_BUCKET="roastery-private"

# EMAIL
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="Roastery <noreply@example.com>"

# WHATSAPP / FONNTE
# WA_API_URL="https://api.fonnte.com/send"
# WA_API_KEY="fonnte-token"

# MIDTRANS (production keys)
# MIDTRANS_SERVER_KEY="Mid-server-xxx"
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-xxx"
# MIDTRANS_IS_PRODUCTION="true"
# NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="true"

# XENDIT / xenPlatform (optional; manual tenant payments remain the default)
# XENDIT_ENABLED="false"
# XENDIT_SECRET_KEY="xnd_development_..."
# XENDIT_WEBHOOK_TOKEN="..."

# GOOGLE OAUTH (optional)
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
# GOOGLE_REDIRECT_URI="https://app.example.com/api/auth/google/callback"

# ARTISAN DESKTOP INTEGRATION
# ARTISAN_CONNECTOR_TOKEN_PEPPER="random-pepper-for-connector-tokens"
# ARTISAN_PAIRING_CODE_PEPPER="random-pepper-for-pairing-codes"
# ARTISAN_MAX_UPLOAD_BYTES=10485760
# ARTISAN_CONNECTOR_DOWNLOAD_URL="https://roastd.id/downloads/RoastdStudio-0.10.2-x64-setup.exe"
# Versi Roastd Studio yang dianggap release aktif di Superadmin Studio Fleet.
STUDIO_LATEST_VERSION=0.10.2

# FEATURE FLAGS (rollout gating for T3 capacity-only + Phase 3 marketing)
# All off by default. Set to "true" to enable.
# FLAG_CAPACITY_ONLY_GATES="false"
# FLAG_PUBLIC_PRICING="false"
# FLAG_CROPSTER_KILLER="false"
# FLAG_ARTISAN_MIGRANT="false"
# FLAG_ROASTLOG_REFUGEE="false"
# FLAG_ROASTIME_BRIDGE="false"
# FLAG_PUBLIC_STATUS_PAGE="false"
