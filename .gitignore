# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/output

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/server-fork-smoke*.log

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# local private object-storage fallback
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mimocode
.mimocode/
.ua/

# local AI/tool configuration
/.claude/
/.kilo/
/.mcp.json

# generated codebase graph (regenerable)
/graphify-out/

# Desktop release artifacts: keep only the current production installer.
/public/downloads/RoastdStudio-*.exe
!/public/downloads/RoastdStudio-0.10.2-x64-setup.exe
/public/downloads/ArtisanSync-*.exe

.vercel
