{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roastd Studio",
  "version": "0.10.2",
  "identifier": "id.roastd.studio",
  "build": {
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Roastd Studio",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../roastd-studio-gpl/src/dist/device-bridge/RoastdDeviceBridge.exe": "device-bridge/RoastdDeviceBridge.exe",
      "../../roastd-studio-gpl/src/dist/device-bridge/LICENSE-AGPL-3.0.txt": "device-bridge/LICENSE-AGPL-3.0.txt"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
